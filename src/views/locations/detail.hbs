{{> breadcrumbs}}

<div class="flex items-center justify-between mb-4">
 <h1 class="text-2xl font-bold text-text-100">{{location.name}}</h1>
 <div class="flex gap-2">
  <a href="/worlds/{{world.id}}/locations/{{location.id}}/edit" class="px-3 py-1.5 rounded-lg border border-surface-300 hover:bg-surface-200 text-sm transition-colors">Edit</a>
  <form method="POST" action="/worlds/{{world.id}}/locations/{{location.id}}/delete" onsubmit="return confirm('Delete this location?')">
   <button type="submit" class="px-3 py-1.5 rounded-lg border border-red-700 text-red-400 hover:bg-red-900/20 text-sm transition-colors">Delete</button>
  </form>
 </div>
</div>

<div class="prose max-w-none mb-8">
 <p class="whitespace-pre-line text-text-200">{{location.description}}</p>
</div>

<div class="space-y-6">
 <div>
  <h2 class="text-lg font-semibold text-text-100 mb-2">Stories set here</h2>
  {{#if stories.length}}
   <ul class="space-y-1">
    {{#each stories}}
     <li>
      <a href="/worlds/{{../../world.id}}/stories/{{this.id}}" class="text-ember-400 hover:text-ember-500 hover:underline">{{this.title}}</a>
      <span class="text-sm text-text-300 ml-2">{{formatDate this.createdAt}}</span>
     </li>
    {{/each}}
   </ul>
  {{else}}
   <p class="text-text-300 italic">No stories yet.</p>
  {{/if}}
 </div>
 <div>
  <h2 class="text-lg font-semibold text-text-100 mb-2">Lore about this place</h2>
  {{#if lore.length}}
   <ul class="space-y-2">
    {{#each lore}}
     <li class="bg-surface-200 rounded-lg p-3 text-text-200 border border-surface-300">{{this.content}}</li>
    {{/each}}
   </ul>
  {{else}}
   <p class="text-text-300 italic">No lore yet.</p>
  {{/if}}
 </div>
</div>

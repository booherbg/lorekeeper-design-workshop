{{> breadcrumbs}}

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold text-ink-900">{{location.name}}</h1>
  <div class="flex gap-2">
    <a href="/worlds/{{world.id}}/locations/{{location.id}}/edit" class="px-3 py-1.5 rounded-lg border border-parchment-200 hover:bg-parchment-100 text-sm transition-colors">Edit</a>
    <form method="POST" action="/worlds/{{world.id}}/locations/{{location.id}}/delete" onsubmit="return confirm('Delete this location?')">
      <button type="submit" class="px-3 py-1.5 rounded-lg border border-red-300 text-red-600 hover:bg-red-50 text-sm transition-colors">Delete</button>
    </form>
  </div>
</div>

<div class="prose max-w-none mb-8">
  <p class="whitespace-pre-line text-ink-700">{{location.description}}</p>
</div>

<div class="space-y-6">
  <div>
    <h2 class="text-lg font-semibold text-ink-900 mb-2">Stories set here</h2>
    {{#if stories.length}}
      <ul class="space-y-1">
        {{#each stories}}
          <li>
            <a href="/worlds/{{../../world.id}}/stories/{{this.id}}" class="text-ember-500 hover:text-ember-700 hover:underline">{{this.title}}</a>
            <span class="text-sm text-parchment-300 ml-2">{{formatDate this.createdAt}}</span>
          </li>
        {{/each}}
      </ul>
    {{else}}
      <p class="text-parchment-300 italic">No stories yet.</p>
    {{/if}}
  </div>
  <div>
    <h2 class="text-lg font-semibold text-ink-900 mb-2">Lore about this place</h2>
    {{#if lore.length}}
      <ul class="space-y-2">
        {{#each lore}}
          <li class="bg-parchment-100 rounded-lg p-3 text-ink-700 border border-parchment-200">{{this.content}}</li>
        {{/each}}
      </ul>
    {{else}}
      <p class="text-parchment-300 italic">No lore yet.</p>
    {{/if}}
  </div>
</div>

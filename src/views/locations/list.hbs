{{> breadcrumbs}}

<div class="flex items-center justify-between mb-6">
 <h1 class="text-2xl font-bold text-text-100">Locations</h1>
 <a href="/worlds/{{world.id}}/locations/new" class="bg-ember-500 text-white px-4 py-2 rounded-lg hover:bg-ember-600 transition-colors">Create Location</a>
</div>

{{#if locations.length}}
 <div class="grid gap-4">
  {{#each locations}}
   <a href="/worlds/{{../world.id}}/locations/{{this.id}}" class="block bg-surface-100 rounded-lg border border-surface-300 p-5 hover:shadow-md hover:border-moss-400 transition-all">
    <h2 class="text-lg font-semibold text-text-100">{{this.name}}</h2>
    <p class="text-text-200 mt-1">{{truncate this.description 150}}</p>
   </a>
  {{/each}}
 </div>
{{else}}
 <div class="text-center py-16">
  <div class="text-4xl mb-4">🏔️</div>
  <p class="text-lg text-text-200 mb-2">Every world needs places.</p>
  <p class="text-text-300 mb-6">Create your first location.</p>
  <a href="/worlds/{{world.id}}/locations/new" class="bg-ember-500 text-white px-5 py-2.5 rounded-lg hover:bg-ember-600 transition-colors">Create Location</a>
 </div>
{{/if}}

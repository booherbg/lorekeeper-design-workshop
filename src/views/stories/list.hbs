{{> breadcrumbs}}

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Stories</h1>
</div>

{{#if stories.length}}
  <div class="space-y-4">
    {{#each stories}}
      <a href="/worlds/{{../world.id}}/stories/{{this.id}}" class="block bg-white rounded-lg shadow p-5 hover:shadow-md transition-shadow">
        <div class="flex items-start justify-between">
          <h2 class="text-lg font-semibold">{{this.title}}</h2>
          <span class="text-sm text-gray-400 ml-4 whitespace-nowrap">{{formatDate this.createdAt}}</span>
        </div>
        <p class="text-gray-600 mt-2">{{truncate this.content 200}}</p>
        {{#if this.storyCharacters.length}}
          <div class="flex flex-wrap gap-1.5 mt-3">
            {{#each this.storyCharacters}}
              <span class="inline-block bg-gray-100 text-gray-700 text-xs px-2 py-0.5 rounded-full">{{this.character.name}}</span>
            {{/each}}
          </div>
        {{/if}}
      </a>
    {{/each}}
  </div>
{{else}}
  <div class="text-center py-12">
    <p class="text-xl font-semibold text-gray-700 mb-4">Your world is waiting for its first story.</p>
    <ol class="text-left max-w-md mx-auto text-gray-600 space-y-3 mb-6">
      <li class="flex gap-3">
        <span class="font-bold text-gray-400">1.</span>
        <span><strong>Set up the AI advisor</strong> — connect Claude Code to Lorekeeper's MCP server. <a href="/setup" class="text-blue-600 underline">Setup guide</a></span>
      </li>
      <li class="flex gap-3">
        <span class="font-bold text-gray-400">2.</span>
        <span><strong>Ask for a story</strong> — tell the advisor something like: "Tell me a bedtime story about [character] at [location]"</span>
      </li>
      <li class="flex gap-3">
        <span class="font-bold text-gray-400">3.</span>
        <span><strong>Review and keep</strong> — your story appears here, along with lore artifacts you can keep or discard</span>
      </li>
    </ol>
    {{#unless hasCharactersOrLocations}}
      <p class="text-sm text-gray-400">Tip: create some characters and locations first — they give the AI material to work with.</p>
    {{/unless}}
  </div>
{{/if}}

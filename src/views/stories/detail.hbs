{{> breadcrumbs}}

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">{{story.title}}</h1>
  <form method="POST" action="/worlds/{{world.id}}/stories/{{story.id}}/delete" onsubmit="return confirm('Delete this story? This also removes lore artifacts from this story.')">
    <button type="submit" class="px-3 py-1.5 rounded border border-red-300 text-red-600 hover:bg-red-50 text-sm">Delete</button>
  </form>
</div>

<p class="text-sm text-gray-400 mb-4">{{formatDate story.createdAt}}</p>

<div class="bg-gray-100 rounded-lg p-4 mb-6">
  <p class="text-sm text-gray-500"><span class="font-medium">Prompt:</span> {{story.prompt}}</p>
</div>

<div class="prose max-w-none mb-8">
  <p class="whitespace-pre-line text-gray-700 leading-relaxed">{{story.content}}</p>
</div>

{{#if characters.length}}
  <div class="mb-6">
    <h2 class="text-lg font-semibold mb-2">Characters in this story</h2>
    <div class="flex flex-wrap gap-2">
      {{#each characters}}
        <a href="/worlds/{{../../world.id}}/characters/{{this.id}}" class="inline-block bg-gray-100 text-gray-700 px-3 py-1 rounded-full hover:bg-gray-200 text-sm">{{this.name}}</a>
      {{/each}}
    </div>
  </div>
{{/if}}

{{#if locations.length}}
  <div class="mb-6">
    <h2 class="text-lg font-semibold mb-2">Locations in this story</h2>
    <div class="flex flex-wrap gap-2">
      {{#each locations}}
        <a href="/worlds/{{../../world.id}}/locations/{{this.id}}" class="inline-block bg-gray-100 text-gray-700 px-3 py-1 rounded-full hover:bg-gray-200 text-sm">{{this.name}}</a>
      {{/each}}
    </div>
  </div>
{{/if}}

{{#if loreArtifacts.length}}
  <div class="mb-6">
    <h2 class="text-lg font-semibold mb-2">Lore artifacts</h2>
    <div class="space-y-3">
      {{#each loreArtifacts}}
        <div class="bg-white rounded-lg shadow p-4" data-lore-id="{{this.id}}">
          <p class="text-gray-700 mb-2">{{this.content}}</p>
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2 text-sm text-gray-500">
              <span class="status-badge inline-block px-2 py-0.5 rounded-full text-xs font-medium
                {{#if (eq this.status 'pending')}}bg-yellow-100 text-yellow-800{{/if}}
                {{#if (eq this.status 'kept')}}bg-green-100 text-green-800{{/if}}
                {{#if (eq this.status 'discarded')}}bg-gray-100 text-gray-600{{/if}}
              ">{{this.status}}</span>
              {{#if this.character}}
                <span>about <a href="/worlds/{{../../world.id}}/characters/{{this.character.id}}" class="text-blue-600 hover:underline">{{this.character.name}}</a></span>
              {{/if}}
              {{#if this.location}}
                <span>at <a href="/worlds/{{../../world.id}}/locations/{{this.location.id}}" class="text-blue-600 hover:underline">{{this.location.name}}</a></span>
              {{/if}}
            </div>
            <div class="flex gap-2 lore-actions">
              {{#unless (eq this.status 'kept')}}
                <button onclick="updateLoreStatus({{this.id}}, 'kept')" class="px-2 py-1 text-xs rounded border border-green-300 text-green-700 hover:bg-green-50">Keep</button>
              {{/unless}}
              {{#unless (eq this.status 'discarded')}}
                <button onclick="updateLoreStatus({{this.id}}, 'discarded')" class="px-2 py-1 text-xs rounded border border-gray-300 text-gray-600 hover:bg-gray-50">Discard</button>
              {{/unless}}
            </div>
          </div>
        </div>
      {{/each}}
    </div>
  </div>

  <script>
  async function updateLoreStatus(id, status) {
    const worldId = {{world.id}};
    const res = await fetch(`/worlds/${worldId}/lore/${id}/status`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status }),
    });
    if (res.ok) {
      const data = await res.json();
      const card = document.querySelector(`[data-lore-id="${id}"]`);
      const badge = card.querySelector('.status-badge');
      badge.textContent = data.status;
      badge.className = 'status-badge inline-block px-2 py-0.5 rounded-full text-xs font-medium ' +
        (data.status === 'kept' ? 'bg-green-100 text-green-800' :
         data.status === 'discarded' ? 'bg-gray-100 text-gray-600' :
         'bg-yellow-100 text-yellow-800');
      const actions = card.querySelector('.lore-actions');
      let buttons = '';
      if (data.status !== 'kept') {
        buttons += `<button onclick="updateLoreStatus(${id}, 'kept')" class="px-2 py-1 text-xs rounded border border-green-300 text-green-700 hover:bg-green-50">Keep</button>`;
      }
      if (data.status !== 'discarded') {
        buttons += `<button onclick="updateLoreStatus(${id}, 'discarded')" class="px-2 py-1 text-xs rounded border border-gray-300 text-gray-600 hover:bg-gray-50">Discard</button>`;
      }
      actions.innerHTML = buttons;
    }
  }
  </script>
{{/if}}

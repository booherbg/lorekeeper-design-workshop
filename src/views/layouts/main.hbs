<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Lorekeeper</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            surface: { 50: '#1a1a1f', 100: '#22222a', 200: '#2a2a34', 300: '#33333f', 400: '#3d3d4a' },
            text: { 100: '#f0ede8', 200: '#d4cfc6', 300: '#9e978b', 400: '#6e685e' },
            ember: { 400: '#e8884d', 500: '#d97742', 600: '#c4632e' },
            moss: { 400: '#6b9461', 500: '#5a7a52' },
          }
        }
      }
    }
  </script>
</head>
<body class="bg-surface-50 min-h-screen text-text-200">
  <nav class="bg-surface-100 border-b border-surface-300">
    <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
      <a href="/worlds" class="text-xl font-bold tracking-tight text-ember-400">Lorekeeper</a>
      <div class="flex items-center gap-4">
        <a href="/worlds" class="text-text-300 hover:text-text-100 text-sm">Worlds</a>
        <a href="/setup" class="text-text-300 hover:text-text-100 text-sm">Setup</a>
      </div>
    </div>
  </nav>
  <main class="max-w-5xl mx-auto px-4 py-8">
    {{{body}}}
  </main>
  <footer class="text-center text-sm text-text-400 pb-6">
    <a href="/lorekeeper" class="hover:text-text-300">~</a>
  </footer>
</body>
</html>

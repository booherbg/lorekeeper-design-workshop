{{> breadcrumbs}}

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Characters</h1>
  <a href="/worlds/{{world.id}}/characters/new" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-700">Create Character</a>
</div>

{{#if characters.length}}
  <div class="grid gap-4">
    {{#each characters}}
      <a href="/worlds/{{../world.id}}/characters/{{this.id}}" class="block bg-white rounded-lg shadow p-5 hover:shadow-md transition-shadow">
        <h2 class="text-lg font-semibold">{{this.name}}</h2>
        <p class="text-gray-600 mt-1">{{truncate this.description 150}}</p>
      </a>
    {{/each}}
  </div>
{{else}}
  <div class="text-center py-12 text-gray-500">
    <p class="text-lg mb-4">This world needs people. Create your first character.</p>
    <a href="/worlds/{{world.id}}/characters/new" class="bg-gray-900 text-white px-4 py-2 rounded hover:bg-gray-700">Create Character</a>
  </div>
{{/if}}

{{> breadcrumbs}}

<div class="flex items-center justify-between mb-4">
  <h1 class="text-2xl font-bold">{{world.name}}</h1>
  <div class="flex gap-2">
    <a href="/worlds/{{world.id}}/edit" class="px-3 py-1.5 rounded border hover:bg-gray-100 text-sm">Edit</a>
    <form method="POST" action="/worlds/{{world.id}}/delete" onsubmit="return confirm('This deletes everything in this world. Continue?')">
      <button type="submit" class="px-3 py-1.5 rounded border border-red-300 text-red-600 hover:bg-red-50 text-sm">Delete</button>
    </form>
  </div>
</div>

{{#if world.description}}
  <p class="text-gray-600 mb-6 whitespace-pre-line">{{world.description}}</p>
{{/if}}

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
  <a href="/worlds/{{world.id}}/characters" class="bg-white rounded-lg shadow p-4 text-center hover:shadow-md transition-shadow">
    <div class="text-2xl font-bold">{{world.characterCount}}</div>
    <div class="text-gray-500 text-sm">Characters</div>
  </a>
  <a href="/worlds/{{world.id}}/locations" class="bg-white rounded-lg shadow p-4 text-center hover:shadow-md transition-shadow">
    <div class="text-2xl font-bold">{{world.locationCount}}</div>
    <div class="text-gray-500 text-sm">Locations</div>
  </a>
  <a href="/worlds/{{world.id}}/stories" class="bg-white rounded-lg shadow p-4 text-center hover:shadow-md transition-shadow">
    <div class="text-2xl font-bold">{{world.storyCount}}</div>
    <div class="text-gray-500 text-sm">Stories</div>
  </a>
  <a href="/worlds/{{world.id}}/lore" class="bg-white rounded-lg shadow p-4 text-center hover:shadow-md transition-shadow">
    <div class="text-2xl font-bold">{{world.loreCount}}</div>
    <div class="text-gray-500 text-sm">Lore</div>
  </a>
</div>

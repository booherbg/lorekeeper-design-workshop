{{> breadcrumbs}}

<div class="flex items-center justify-between mb-4">
 <h1 class="text-2xl font-bold text-text-100">{{world.name}}</h1>
 <div class="flex gap-2">
  <a href="/worlds/{{world.id}}/edit" class="px-3 py-1.5 rounded-lg border border-surface-300 hover:bg-surface-200 text-sm transition-colors">Edit</a>
  <form method="POST" action="/worlds/{{world.id}}/delete" onsubmit="return confirm('This deletes everything in this world. Continue?')">
   <button type="submit" class="px-3 py-1.5 rounded-lg border border-red-700 text-red-400 hover:bg-red-900/20 text-sm transition-colors">Delete</button>
  </form>
 </div>
</div>

{{#if world.description}}
 <p class="text-text-200 mb-6 whitespace-pre-line">{{world.description}}</p>
{{/if}}

{{#if showStoryCallout}}
 <div class="bg-amber-900/20 border border-amber-700 rounded-lg p-5 mt-6">
  <h2 class="text-lg font-semibold text-amber-300 mb-2">Ready for a story?</h2>
  <p class="text-amber-400 text-sm mb-3">Your world has {{world.characterCount}} character{{#unless (eq world.characterCount 1)}}s{{/unless}} and {{world.locationCount}} location{{#unless (eq world.locationCount 1)}}s{{/unless}}. Ask your AI advisor to generate a story — it'll draw from everything you've built here.</p>
  <a href="/setup" class="text-ember-400 text-sm font-medium hover:text-ember-500">Set up MCP connection &rarr;</a>
 </div>
{{/if}}

<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
 <a href="/worlds/{{world.id}}/characters" class="bg-surface-100 rounded-lg border border-surface-300 p-4 text-center hover:shadow-md hover:border-ember-500 transition-all">
  <div class="text-2xl font-bold text-ember-400">{{world.characterCount}}</div>
  <div class="text-text-300 text-sm">Characters</div>
 </a>
 <a href="/worlds/{{world.id}}/locations" class="bg-surface-100 rounded-lg border border-surface-300 p-4 text-center hover:shadow-md hover:border-moss-400 transition-all">
  <div class="text-2xl font-bold text-moss-500">{{world.locationCount}}</div>
  <div class="text-text-300 text-sm">Locations</div>
 </a>
 <a href="/worlds/{{world.id}}/stories" class="bg-surface-100 rounded-lg border border-surface-300 p-4 text-center hover:shadow-md hover:border-text-300 transition-all">
  <div class="text-2xl font-bold text-text-200">{{world.storyCount}}</div>
  <div class="text-text-300 text-sm">Stories</div>
 </a>
 <a href="/worlds/{{world.id}}/lore" class="bg-surface-100 rounded-lg border border-surface-300 p-4 text-center hover:shadow-md hover:border-amber-500 transition-all">
  <div class="text-2xl font-bold text-amber-400">{{world.loreCount}}</div>
  <div class="text-text-300 text-sm">Lore</div>
 </a>
</div>

{{> breadcrumbs}}

<h1 class="text-2xl font-bold text-text-100 mb-6">{{#if world}}Edit World{{else}}New World{{/if}}</h1>

<form method="POST" action="{{#if world}}/worlds/{{world.id}}/update{{else}}/worlds{{/if}}" class="space-y-4 max-w-lg">
 <div>
  <label for="name" class="block text-sm font-medium text-text-200 mb-1">Name</label>
  <input type="text" id="name" name="name" value="{{#if world}}{{world.name}}{{/if}}" required maxlength="255" class="w-full border border-surface-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-ember-400 focus:border-ember-400 bg-surface-100">
 </div>
 <div>
  <label for="description" class="block text-sm font-medium text-text-200 mb-1">Description</label>
  <textarea id="description" name="description" rows="4" class="w-full border border-surface-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-ember-400 focus:border-ember-400 bg-surface-100">{{#if world}}{{world.description}}{{/if}}</textarea>
 </div>
 <div class="flex gap-3">
  <button type="submit" class="bg-ember-500 text-white px-4 py-2 rounded-lg hover:bg-ember-600 transition-colors">Save</button>
  <a href="{{#if world}}/worlds/{{world.id}}{{else}}/worlds{{/if}}" class="px-4 py-2 rounded-lg border border-surface-300 hover:bg-surface-200 transition-colors">Cancel</a>
 </div>
</form>

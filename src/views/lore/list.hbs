{{> breadcrumbs}}

<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl font-bold">Lore</h1>
</div>

<div class="flex gap-2 mb-6">
  <a href="/worlds/{{world.id}}/lore" class="px-3 py-1.5 rounded text-sm {{#if (eq currentFilter 'all')}}bg-gray-900 text-white{{else}}border hover:bg-gray-100{{/if}}">All</a>
  <a href="/worlds/{{world.id}}/lore?status=pending" class="px-3 py-1.5 rounded text-sm {{#if (eq currentFilter 'pending')}}bg-yellow-500 text-white{{else}}border hover:bg-gray-100{{/if}}">Pending</a>
  <a href="/worlds/{{world.id}}/lore?status=kept" class="px-3 py-1.5 rounded text-sm {{#if (eq currentFilter 'kept')}}bg-green-600 text-white{{else}}border hover:bg-gray-100{{/if}}">Kept</a>
  <a href="/worlds/{{world.id}}/lore?status=discarded" class="px-3 py-1.5 rounded text-sm {{#if (eq currentFilter 'discarded')}}bg-gray-400 text-white{{else}}border hover:bg-gray-100{{/if}}">Discarded</a>
</div>

{{#if lore.length}}
  <div class="space-y-4">
    {{#each lore}}
      <div class="bg-white rounded-lg shadow p-5" data-lore-id="{{this.id}}">
        <p class="text-gray-700 mb-3">{{this.content}}</p>
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3 text-sm text-gray-500">
            <span class="status-badge inline-block px-2 py-0.5 rounded-full text-xs font-medium
              {{#if (eq this.status 'pending')}}bg-yellow-100 text-yellow-800{{/if}}
              {{#if (eq this.status 'kept')}}bg-green-100 text-green-800{{/if}}
              {{#if (eq this.status 'discarded')}}bg-gray-100 text-gray-600{{/if}}
            ">{{this.status}}</span>
            {{#if this.story}}
              <span>from <a href="/worlds/{{../world.id}}/stories/{{this.story.id}}" class="text-blue-600 hover:underline">{{this.story.title}}</a></span>
            {{/if}}
            {{#if this.character}}
              <span>about <a href="/worlds/{{../world.id}}/characters/{{this.character.id}}" class="text-blue-600 hover:underline">{{this.character.name}}</a></span>
            {{/if}}
            {{#if this.location}}
              <span>at <a href="/worlds/{{../world.id}}/locations/{{this.location.id}}" class="text-blue-600 hover:underline">{{this.location.name}}</a></span>
            {{/if}}
          </div>
          <div class="flex gap-2 lore-actions">
            {{#unless (eq this.status 'kept')}}
              <button onclick="updateLoreStatus({{this.id}}, 'kept')" class="px-2 py-1 text-xs rounded border border-green-300 text-green-700 hover:bg-green-50">Keep</button>
            {{/unless}}
            {{#unless (eq this.status 'discarded')}}
              <button onclick="updateLoreStatus({{this.id}}, 'discarded')" class="px-2 py-1 text-xs rounded border border-gray-300 text-gray-600 hover:bg-gray-50">Discard</button>
            {{/unless}}
          </div>
        </div>
      </div>
    {{/each}}
  </div>
{{else}}
  <div class="text-center py-12 text-gray-500">
    <p class="text-lg">Lore emerges from stories. Generate a story first, and artifacts will appear here.</p>
  </div>
{{/if}}

<script>
async function updateLoreStatus(id, status) {
  const worldId = {{world.id}};
  const res = await fetch(`/worlds/${worldId}/lore/${id}/status`, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ status }),
  });
  if (res.ok) {
    const data = await res.json();
    const card = document.querySelector(`[data-lore-id="${id}"]`);
    const badge = card.querySelector('.status-badge');
    badge.textContent = data.status;
    badge.className = 'status-badge inline-block px-2 py-0.5 rounded-full text-xs font-medium ' +
      (data.status === 'kept' ? 'bg-green-100 text-green-800' :
       data.status === 'discarded' ? 'bg-gray-100 text-gray-600' :
       'bg-yellow-100 text-yellow-800');
    const actions = card.querySelector('.lore-actions');
    let buttons = '';
    if (data.status !== 'kept') {
      buttons += `<button onclick="updateLoreStatus(${id}, 'kept')" class="px-2 py-1 text-xs rounded border border-green-300 text-green-700 hover:bg-green-50">Keep</button>`;
    }
    if (data.status !== 'discarded') {
      buttons += `<button onclick="updateLoreStatus(${id}, 'discarded')" class="px-2 py-1 text-xs rounded border border-gray-300 text-gray-600 hover:bg-gray-50">Discard</button>`;
    }
    actions.innerHTML = buttons;
  }
}
</script>

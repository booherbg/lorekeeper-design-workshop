{{> breadcrumbs}}

<div class="flex items-center justify-between mb-6">
 <h1 class="text-2xl font-bold text-text-100">Lore</h1>
</div>

<div class="flex gap-2 mb-6">
 <a href="/worlds/{{world.id}}/lore" class="px-3 py-1.5 rounded-lg text-sm transition-colors {{#if (eq currentFilter 'all')}}bg-surface-300 text-text-100{{else}}border border-surface-300 hover:bg-surface-200{{/if}}">All</a>
 <a href="/worlds/{{world.id}}/lore?status=pending" class="px-3 py-1.5 rounded-lg text-sm transition-colors {{#if (eq currentFilter 'pending')}}bg-yellow-500 text-white{{else}}border border-surface-300 hover:bg-surface-200{{/if}}">Pending</a>
 <a href="/worlds/{{world.id}}/lore?status=kept" class="px-3 py-1.5 rounded-lg text-sm transition-colors {{#if (eq currentFilter 'kept')}}bg-green-600 text-white{{else}}border border-surface-300 hover:bg-surface-200{{/if}}">Kept</a>
 <a href="/worlds/{{world.id}}/lore?status=discarded" class="px-3 py-1.5 rounded-lg text-sm transition-colors {{#if (eq currentFilter 'discarded')}}bg-gray-400 text-white{{else}}border border-surface-300 hover:bg-surface-200{{/if}}">Discarded</a>
</div>

{{#if lore.length}}
 <div class="space-y-4">
  {{#each lore}}
   <div class="bg-surface-100 rounded-lg border border-surface-300 p-5" data-lore-id="{{this.id}}">
    <p class="text-text-200 mb-3">{{this.content}}</p>
    <div class="flex items-center justify-between">
     <div class="flex items-center gap-3 text-sm text-text-300">
      <span class="status-badge inline-block px-2 py-0.5 rounded-full text-xs font-medium
       {{#if (eq this.status 'pending')}}bg-yellow-900/30 text-yellow-400{{/if}}
       {{#if (eq this.status 'kept')}}bg-green-900/30 text-green-400{{/if}}
       {{#if (eq this.status 'discarded')}}bg-surface-300 text-text-300{{/if}}
      ">{{this.status}}</span>
      {{#if this.story}}
       <span>from <a href="/worlds/{{../world.id}}/stories/{{this.story.id}}" class="text-ember-400 hover:underline">{{this.story.title}}</a></span>
      {{/if}}
      {{#if this.character}}
       <span>about <a href="/worlds/{{../world.id}}/characters/{{this.character.id}}" class="text-ember-400 hover:underline">{{this.character.name}}</a></span>
      {{/if}}
      {{#if this.location}}
       <span>at <a href="/worlds/{{../world.id}}/locations/{{this.location.id}}" class="text-ember-400 hover:underline">{{this.location.name}}</a></span>
      {{/if}}
     </div>
     <div class="flex gap-2 lore-actions">
      {{#unless (eq this.status 'kept')}}
       <button onclick="updateLoreStatus({{this.id}}, 'kept')" class="px-2 py-1 text-xs rounded-lg border border-green-700 text-green-400 hover:bg-green-900/20">Keep</button>
      {{/unless}}
      {{#unless (eq this.status 'discarded')}}
       <button onclick="updateLoreStatus({{this.id}}, 'discarded')" class="px-2 py-1 text-xs rounded-lg border border-surface-300 text-text-300 hover:bg-surface-200">Discard</button>
      {{/unless}}
     </div>
    </div>
   </div>
  {{/each}}
 </div>
{{else}}
 <div class="text-center py-16">
  <div class="text-4xl mb-4">🔮</div>
  <p class="text-lg text-text-200 mb-2">Lore emerges from stories.</p>
  <p class="text-text-300">Generate a story first, and artifacts will appear here.</p>
 </div>
{{/if}}

<script>
async function updateLoreStatus(id, status) {
 const worldId = {{world.id}};
 const res = await fetch(`/worlds/${worldId}/lore/${id}/status`, {
  method: 'POST',
  headers: { 'Content-Type': 'application/json' },
  body: JSON.stringify({ status }),
 });
 if (res.ok) {
  const data = await res.json();
  const card = document.querySelector(`[data-lore-id="${id}"]`);
  const badge = card.querySelector('.status-badge');
  badge.textContent = data.status;
  badge.className = 'status-badge inline-block px-2 py-0.5 rounded-full text-xs font-medium ' +
   (data.status === 'kept' ? 'bg-green-900/30 text-green-400' :
    data.status === 'discarded' ? 'bg-surface-300 text-text-300' :
    'bg-yellow-900/30 text-yellow-400');
  const actions = card.querySelector('.lore-actions');
  let buttons = '';
  if (data.status !== 'kept') {
   buttons += `<button onclick="updateLoreStatus(${id}, 'kept')" class="px-2 py-1 text-xs rounded-lg border border-green-700 text-green-400 hover:bg-green-900/20">Keep</button>`;
  }
  if (data.status !== 'discarded') {
   buttons += `<button onclick="updateLoreStatus(${id}, 'discarded')" class="px-2 py-1 text-xs rounded-lg border border-surface-300 text-text-300 hover:bg-surface-200">Discard</button>`;
  }
  actions.innerHTML = buttons;
 }
}
</script>

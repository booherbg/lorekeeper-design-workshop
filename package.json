  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/booherbg/lorekeeper-design-workshop/issues"
  },
  "homepage": "https://github.com/booherbg/lorekeeper-design-workshop#readme",
  "dependencies": {
    "@fastify/formbody": "^8.0.2",
    "@fastify/static": "^9.1.3",
    "@fastify/view": "^11.1.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^6.19.3",
    "@types/node": "^25.6.0",
    "fastify": "^5.8.5",
    "handlebars": "^4.7.9",
    "prisma": "^6.19.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "vitest": "^4.1.5"
  }
}
